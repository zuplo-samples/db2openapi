{
  "name": "db2openapi",
  "version": "1.0.0",
  "description": "Generate an OpenAPI/Swagger specification from your SQL database",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --coverageDirectory=coverage --testPathIgnorePatterns='/__tests__/.*\\.int\\.test\\.ts$'",
    "test:unit": "jest --passWithNoTests --testPathIgnorePatterns='/__tests__/.*\\.int\\.test\\.ts$'",
    "test:integration": "jest --passWithNoTests --testPathPattern='.*\\.int\\.test\\.ts$'",
    "fix-cov-paths": "node ./scripts/fix-lcov-paths.js",
    "posttest:cov": "npm run fix-cov-paths",
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "examples": "make examples",
    "clean:examples": "node ./scripts/clean-examples.js",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "bin": {
    "db2openapi": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuplo-samples/db2openapi.git"
  },
  "keywords": [
    "database",
    "SQL",
    "OpenAPI",
    "Swagger"
  ],
  "author": "Zuplo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zuplo-samples/db2openapi/issues"
  },
  "homepage": "https://github.com/zuplo-samples/db2openapi#readme",
  "devDependencies": {
    "typescript": "^5.6.3",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.3"
  },
  "dependencies": {
    "@types/node": "^22.9.1",
    "commander": "^12.1.0",
    "mariadb": "^3.4.0",
    "mysql2": "^3.11.5",
    "openapi-types": "^12.1.3",
    "oracledb": "^6.7.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "tedious": "^18.6.1"
  }
}
